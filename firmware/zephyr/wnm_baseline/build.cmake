set(CONF_FILE "${CMAKE_CURRENT_LIST_DIR}/prj.conf")
set(KCONFIG_ROOT "${CMAKE_CURRENT_LIST_DIR}/../Kconfig")
set(DTC_OVERLAY_FILE "${CMAKE_CURRENT_LIST_DIR}/../boards/edgez_nrf54l15_fgh200m_radar.overlay;${CMAKE_CURRENT_LIST_DIR}/board.overlay")
set(EXTRA_CONF_FILE "${CMAKE_CURRENT_LIST_DIR}/../halowlink2.conf;${CMAKE_CURRENT_LIST_DIR}/../halowlink2-secrets.conf")
if(DEFINED ENV{MORSE_ZEPHYR_MODULE})
 list(APPEND ZEPHYR_EXTRA_MODULES "$ENV{MORSE_ZEPHYR_MODULE}")
else()
 list(APPEND ZEPHYR_EXTRA_MODULES "${RADAR_NRF54_DIR}/platforms/mm-iot-zephyr")
endif()
find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
project(ez_dev54_wnm_baseline)
target_compile_definitions(app PRIVATE HALOW_WNM_BASELINE=1)
if(EZ_DEV54_DTIM_BASELINE)
 target_compile_definitions(app PRIVATE HALOW_DTIM_BASELINE=1 HALOW_RADIO_ONLY=1)
endif()
target_include_directories(app PRIVATE "${RADAR_NRF54_DIR}/src")
target_sources(app PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../all_off/main.c" "${CMAKE_CURRENT_LIST_DIR}/radio.c" "${RADAR_NRF54_DIR}/src/halow_wnm_pins.c")
target_link_libraries(app PRIVATE libmorse_interface)
foreach(morse_target mmhostap morselib mmutils)
 if(TARGET ${morse_target})
  target_include_directories(${morse_target} PRIVATE "${RADAR_NRF54_DIR}/compat")
 endif()
endforeach()
add_custom_target(radar_pio_prebuild)
add_dependencies(radar_pio_prebuild libmorse_build firmware)
