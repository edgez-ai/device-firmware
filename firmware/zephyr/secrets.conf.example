# Copy to secrets.conf (not tracked by git) and fill in.
CONFIG_RADAR_HALOW_SSID="my-halow-ap"
CONFIG_RADAR_HALOW_PASSWORD="my-sae-password"
CONFIG_WIFI_MORSEMICRO_REGION="US"
# Optional when AP DHCP does not supply a router:
CONFIG_RADAR_HALOW_GATEWAY="10.83.0.1"
CONFIG_RADAR_MQTT_USERNAME="your-mqtt-username"
CONFIG_RADAR_MQTT_PASSWORD="your-mqtt-password"
