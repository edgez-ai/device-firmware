CONFIG_EZ_DEV01_STATION=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"
CONFIG_HALOW_MESH_MODE=n
CONFIG_HALOW_MESH_AUTO_JOIN=n
CONFIG_HALOW_EDGEZ_BATMAN=n
CONFIG_DAB_START_BATMAN=n
CONFIG_DAB_START_MQTT_RELAY=n
CONFIG_DAB_START_NETWORK_PACKET_RELAY=n
CONFIG_DAB_WIFI_EXTENDER=n
CONFIG_HALOW_PAWR_ENABLE=n
CONFIG_HALOW_BLE_PROVISIONING=n
CONFIG_HALOW_COUNTRY_CODE="US"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_CIPHER_MODE_CTR=y

CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# HaLow is the station radio; do not link ESP32 2.4 GHz Wi-Fi/supplicant.
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_HOST_WIFI_ENABLED=n
